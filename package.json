{
  "name": "@ryze-digital/content-zoom",
  "description": " Enlarges the width of a container or opens it in a dialog ",
  "license": "MIT",
  "version": "1.0.0",
  "author": "RYZE Digital GmbH <kontakt@ryze-digital.de> (https://www.ryze-digital.de/)",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "lint": "npm-run-all --parallel lint:*",
    "lint:scripts": "prettier src/scripts tests/scripts ./*.js --check && eslint src/scripts tests/scripts ./*.js",
    "lint:styles": "prettier src/styles/** ./*.scss --check && stylelint src/styles/** ./*.scss",
    "lint-fix": "npm-run-all --parallel lint-fix:* --continue-on-error",
    "lint-fix:scripts": "prettier src/scripts tests/scripts ./*.js --write && npm run lint:scripts -- --fix",
    "lint-fix:styles": "prettier src/styles/** ./*.scss --write && npm run lint:styles -- --fix",
    "test": "npm run test:scripts",
    "test:scripts": "jest",
    "test:scripts:coverage": "jest --coverage",
    "build": "npm-run-all --parallel lint:* sass:build --continue-on-error",
    "watch": "npm run sass:watch",
    "sass:build": "sass demos/demo.scss:demos/build/demo.css --no-source-map --load-path=node_modules",
    "sass:watch": "sass demos/demo.scss:demos/build/demo.css --no-source-map --load-path=node_modules --load-path=src/styles --watch --poll"
  },
  "devDependencies": {
    "@ryze-digital/eslint-config-website": "^2.0.0",
    "@ryze-digital/prettier-config-website": "^2.0.0",
    "@ryze-digital/stylelint-config-website": "^2.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-junit": "^17.0.0",
    "npm-run-all2": "^9.0.4",
    "sass": "^1.108.2"
  },
  "dependencies": {
    "@ryze-digital/js-utilities": "^1.2.0",
    "@ryze-digital/scss-utilities": "^1.1.2"
  }
}
